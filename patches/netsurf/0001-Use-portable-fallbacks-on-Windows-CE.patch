From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phil Howard <phil@pimoroni.com>
Date: Thu, 29 Oct 2026 10:36:32 +0000
Subject: [PATCH] Use portable fallbacks on Windows CE


diff --git a/utils/config.h b/utils/config.h
index 3914771fd..2eb98b8e8 100644
--- a/utils/config.h
+++ b/utils/config.h
@@ -54,7 +54,8 @@ char *strndup(const char *s, size_t n);
       defined(__HAIKU__) ||			\
       defined(__NetBSD__) ||			\
       defined(__OpenBSD__)) &&			\
-     !defined(__serenity__))
+     !defined(__serenity__) &&			\
+     !defined(_WIN32_WCE))
 #define HAVE_STRCASESTR
 #else
 #undef HAVE_STRCASESTR
@@ -65,6 +66,7 @@ char *strcasestr(const char *haystack, const char *needle);
  *  appear not to support the time_t seconds format specifier.
  */
 #if (defined(_WIN32) ||	      \
+     defined(_WIN32_WCE) ||   \
      defined(__riscos__) ||   \
      defined(__HAIKU__) ||    \
      defined(__BEOS__) ||     \
@@ -109,22 +111,23 @@ char *strchrnul(const char *s, int c);
 
 #define HAVE_INETATON
 #if (defined(_WIN32) || \
+     defined(_WIN32_WCE) || \
      defined(__serenity__))
 #undef HAVE_INETATON
 #endif
 
 #define HAVE_INETPTON
-#if (defined(_WIN32))
+#if (defined(_WIN32) || defined(_WIN32_WCE))
 #undef HAVE_INETPTON
 #endif
 
 #define HAVE_UTSNAME
-#if (defined(_WIN32))
+#if (defined(_WIN32) || defined(_WIN32_WCE))
 #undef HAVE_UTSNAME
 #endif
 
 #define HAVE_REALPATH
-#if (defined(_WIN32))
+#if (defined(_WIN32) || defined(_WIN32_WCE))
 #undef HAVE_REALPATH
 char *realpath(const char *path, char *resolved_path);
 #endif
@@ -135,22 +138,22 @@ char *realpath(const char *path, char *resolved_path);
 #endif
 
 #define HAVE_SIGPIPE
-#if (defined(_WIN32))
+#if (defined(_WIN32) || defined(_WIN32_WCE))
 #undef HAVE_SIGPIPE
 #endif
 
 #define HAVE_STDOUT
-#if (defined(_WIN32))
+#if (defined(_WIN32) || defined(_WIN32_WCE))
 #undef HAVE_STDOUT
 #endif
 
 #define HAVE_MMAP
-#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__))
+#if (defined(_WIN32) || defined(_WIN32_WCE) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__))
 #undef HAVE_MMAP
 #endif
 
 #define HAVE_SCANDIR
-#if (defined(_WIN32) ||				\
+#if (defined(_WIN32) || defined(_WIN32_WCE) ||				\
      defined(__serenity__))
 #undef HAVE_SCANDIR
 #endif
@@ -158,14 +161,14 @@ char *realpath(const char *path, char *resolved_path);
 #define HAVE_DIRFD
 #define HAVE_UNLINKAT
 #define HAVE_FSTATAT
-#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__))
+#if (defined(_WIN32) || defined(_WIN32_WCE) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__))
 #undef HAVE_DIRFD
 #undef HAVE_UNLINKAT
 #undef HAVE_FSTATAT
 #endif
 
 #define HAVE_REGEX
-#if (defined(__serenity__))
+#if (defined(__serenity__) || defined(_WIN32_WCE))
 #undef HAVE_REGEX
 #endif
 
@@ -185,7 +188,7 @@ char *realpath(const char *path, char *resolved_path);
 #if defined(riscos)
     /* Theme auto-install */
     #define WITH_THEME_INSTALL
-#elif defined(__HAIKU__) || defined(__BEOS__)
+#elif defined(__HAIKU__) || defined(__BEOS__) || defined(_WIN32_WCE)
     /* for intptr_t */
     #include <inttypes.h>
     #if defined(__HAIKU__)
